<UserControl x:Class="BLDC_Demo.ZMP_MODE"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:BLDC_Demo"
             mc:Ignorable="d" 
             Height="431"
             Width="720"
             Background="#E4EAF6"
             FontFamily="Segoe UI"
             FontSize="12">

    <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="130"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="55"/>
            <RowDefinition Height="55"/>
            <RowDefinition Height="55"/>
            <RowDefinition Height="70"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="1" Grid.Column="0" 
                   Text="ZPA MODE" 
                   Style="{StaticResource FieldLabel}" 
                   VerticalAlignment="Center"/>

        <ComboBox Grid.Row="1" Grid.Column="1" 
                  x:Name="ZpaModeComboBox" 
                  Width="180"  Style="{StaticResource DarkComboBox}" 
                  HorizontalAlignment="Left" 
                  VerticalAlignment="Center"
                  Height="32">
            <ComboBoxItem Content="Singulation" IsSelected="True"/>
            <ComboBoxItem Content="Train"/>
            <ComboBoxItem Content="GAP Train"/>
        </ComboBox>

        <TextBlock Grid.Row="2" Grid.Column="0" 
                   Text="GAP TIMER (ms)" 
                   Style="{StaticResource FieldLabel}" 
                   VerticalAlignment="Center"/>

        <TextBox Grid.Row="2" Grid.Column="1" 
                 x:Name="GapTimerTextBox" 
                 Width="180" 
                 HorizontalAlignment="Left" 
                 VerticalAlignment="Center"
                 Foreground="#5A6A8A" 
                 Style="{StaticResource DarkTextBox1}"/>

        <TextBlock Grid.Row="3" Grid.Column="0" 
                   Text="ZONE ACCEPT TIME" 
                   Style="{StaticResource FieldLabel}" 
                   VerticalAlignment="Center"/>

        <TextBox Grid.Row="3" Grid.Column="1" 
                 x:Name="ZoneAcceptTimeTextBox" 
                 Width="180" 
                 HorizontalAlignment="Left" 
                 VerticalAlignment="Center"
                 Foreground="#5A6A8A" 
                 Style="{StaticResource DarkTextBox1}"/>

        <Button Grid.Row="4" Grid.Column="1" 
                Content="Set Mode" 
                Style="{StaticResource SetButton}" 
                Width="80" 
                HorizontalAlignment="Left" 
                VerticalAlignment="Center"
                Click="SetModeButton_Click" RenderTransformOrigin="0.873,0.523" Margin="48,0,0,0">
            <Button.Effect>
                <DropShadowEffect Color="#5A6A8A" BlurRadius="14" ShadowDepth="0" Opacity="0.35"/>
            </Button.Effect>
        </Button>
    </Grid>
</UserControl>
<UserControl x:Class="BLDC_Demo.ZPASettingControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <Style x:Key="ModernToggleSwitch" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Track" Width="38" Height="20" Background="#E2E8F0" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="10">
                            <Ellipse x:Name="Thumb" Width="14" Height="14" Fill="White" HorizontalAlignment="Left" Margin="3,0,0,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{StaticResource BlueBrush}"/>
                                <Setter TargetName="Track" Property="BorderBrush" Value="#0D47A1"/>
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Thumb" Property="Margin" Value="0,0,3,0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Background="White"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="10"
            Padding="18,5">

        <StackPanel>

            <!-- Header: Title (Left) + Edit Mode Toggle (Right) -->
            <Grid Margin="0,18,0,16">
                <!-- Left: Title -->
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center">

                    <Rectangle Width="2"
                               Height="12"
                               Fill="{StaticResource AccentBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,10,0"
                               RadiusX="2"
                               RadiusY="2"/>

                    <TextBlock Text="ZPA SETTING (ZERO PRESSURE ACCUMULATION)"
                               FontFamily="Arial Black"
                               FontSize="11"
                               FontWeight="Black"
                               Foreground="{StaticResource AccentBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Right: ZPA Status Indicator & Edit Mode Toggle -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">

                    <Path Width="11" Height="11" Stretch="Uniform" Fill="{StaticResource AccentBrush}" Margin="0,0,6,0" VerticalAlignment="Center"
                          Data="M3,17.25V21h3.75L17.81,9.94l-3.75-3.75L3,17.25z M20.71,7.04c0.39-0.39,0.39-1.02,0-1.41l-2.34-2.34c-0.39-0.39-1.02-0.39-1.41,0l-1.83,1.83l3.75,3.75L20.71,7.04z"/>
                    <TextBlock Text="EDIT" FontFamily="Consolas" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <ToggleButton x:Name="EditModeToggle"
                                  IsChecked="False"
                                  VerticalAlignment="Center"
                                  Style="{StaticResource ModernToggleSwitch}"
                                  Click="EditModeToggle_Click"
                                  ToolTip="Toggle Edit Mode to modify ZPA settings"/>
                </StackPanel>
            </Grid>

            <!-- ZPA fields -->
            <Border x:Name="RootBorder">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="18"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="14"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- MODE -->
                    <StackPanel Grid.Row="0"
                                Grid.Column="0">

                        <TextBlock Text="▸ MODE"
                                   Style="{StaticResource FieldLabel}"/>

                        <ComboBox x:Name="ModeComboBox"
                                  Foreground="#5A6A8A"
                                  Style="{StaticResource DarkComboBox}"
                                  ItemContainerStyle="{StaticResource MutedComboItem}"
                                  SelectionChanged="ModeComboBox_SelectionChanged">

                            <ComboBoxItem Content="OFF"/>
                            <ComboBoxItem Content="GAP Train"/>

                        </ComboBox>
                    </StackPanel>

                    <!-- MDR DIRECTION -->
                    <StackPanel Grid.Row="0"
                                Grid.Column="2">

                        <TextBlock Text="▸ MDR DIRECTION"
                                   Style="{StaticResource FieldLabel}"/>

                        <ComboBox x:Name="MDRDirectionComboBox"
                                  Foreground="#5A6A8A"
                                  Style="{StaticResource DarkComboBox}"
                                  ItemContainerStyle="{StaticResource MutedComboItem}"
                                  SelectionChanged="MDRDirectionComboBox_SelectionChanged">

                            <ComboBoxItem Content="Clock Wise"/>
                            <ComboBoxItem Content="Anticlockwise"/>

                        </ComboBox>
                    </StackPanel>



                    <!-- ZPA DIRECTION -->
                    <StackPanel Grid.Row="0"
                              Grid.Column="4">

                                 <TextBlock Text="▸ ZPA DIRECTION"
                                 Style="{StaticResource FieldLabel}"/>

                                    <ComboBox x:Name="ipdirection"
                                Foreground="#5A6A8A"
                                Style="{StaticResource DarkComboBox}"
                                ItemContainerStyle="{StaticResource MutedComboItem}"
                                SelectionChanged="IpDirection_SelectionChanged">

                                        <ComboBoxItem Content="Up Stream "/>
                                        <ComboBoxItem Content="Down stream"/>

                                    </ComboBox>         
                    </StackPanel>


                    <!-- MDR OFF DELAY -->
                    

                    <!-- MDR OFF FLAG -->
                    <StackPanel Grid.Row="2"
                                 Grid.Column="0">

                                            <TextBlock Text="▸ MDR OFF FLAG"
                                    Style="{StaticResource FieldLabel}"/>

                                        <ComboBox x:Name="MDRflagComboBox"
                                   Foreground="#5A6A8A"
                                   Style="{StaticResource DarkComboBox}"
                                   ItemContainerStyle="{StaticResource MutedComboItem}"
                                   SelectionChanged="MDRflagComboBox_SelectionChanged">

                                            <ComboBoxItem Content="Enable"/>
                                            <ComboBoxItem Content="Disable"/>

                                        </ComboBox>     
                    </StackPanel>

                    <!-- UPSTREAM IP -->
                    <StackPanel Grid.Row="2"
                                Grid.Column="2">

                        <TextBlock Text="▸ MASTER IP"
                                   Style="{StaticResource FieldLabel}"/>

                        <TextBox x:Name="UpStreamIPTextBox"
                                 Foreground="#5A6A8A"
                                 Style="{StaticResource DarkTextBox}"
                                 IsReadOnly="False"/>
                    </StackPanel>

                    <!-- DOWNSTREAM IP -->
                    <StackPanel Grid.Row="2"
                                Grid.Column="4">

                        <TextBlock Text="▸ LAST IP"
                                   Style="{StaticResource FieldLabel}"/>

                        <TextBox x:Name="DownStreamIPTextBox"
                                 Foreground="#5A6A8A"
                                 Style="{StaticResource DarkTextBox}"
                                 IsReadOnly="False"/>
                    </StackPanel>

                  
                   

                    <!-- SET CONFIGURATION BUTTON -->
                    <Button x:Name="SetConfigurationButton"
                            Grid.Row="4"
                            Grid.ColumnSpan="5"
                            HorizontalAlignment="Right"
                            Content="Set Configuration"
                            Style="{StaticResource AdvancedButton}"
                            Width="Auto"
                            Padding="16,0"
                            Margin="0,0,0,4"
                            Click="SetConfigurationButton_Click">
                        <Button.Effect>
                            <DropShadowEffect Color="#5A6A8A" BlurRadius="8" ShadowDepth="0" Opacity="0.20"/>
                        </Button.Effect>
                    </Button>

                </Grid>
            </Border>
        </StackPanel>
    </Border>

</UserControl>

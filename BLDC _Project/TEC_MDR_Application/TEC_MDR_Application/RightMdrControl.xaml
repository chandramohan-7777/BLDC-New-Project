<UserControl x:Class="BLDC_Demo.RightMdrControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:models="clr-namespace:BLDC_Demo.Models"
             mc:Ignorable="d">

    <UserControl.Resources>
        <Style x:Key="ErrorFlagStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Style.Triggers>
                <Trigger Property="Tag" Value="1">
                    <Setter Property="Foreground" Value="Red"/>
                </Trigger>
                <Trigger Property="Tag" Value="0">
                    <Setter Property="Foreground" Value="LimeGreen"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- SET button that is enabled/disabled through the SetButtonsEnabled property -->
        <Style x:Key="LockableSetButton"
       TargetType="Button"
       BasedOn="{StaticResource SetButton}">

            <Setter Property="IsEnabled"
            Value="{Binding SetButtonsEnabled,
                    RelativeSource={RelativeSource AncestorType=UserControl}}"/>

            <!-- Button Border -->
            <Setter Property="BorderBrush" Value="#999999"/>
            <Setter Property="BorderThickness" Value="1"/>

            <!-- Shadow -->
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect
                Color="#5A6A8A"
                BlurRadius="14"
                ShadowDepth="0"
                Opacity="0.30"/>
                </Setter.Value>
            </Setter>

            <Style.Triggers>

                <!-- Disabled -->
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Effect" Value="{x:Null}"/>
                    <Setter Property="Opacity" Value="0.5"/>
                    <Setter Property="BorderBrush" Value="#999999"/>
                </Trigger>

            </Style.Triggers>

        </Style>
    </UserControl.Resources>

    <!-- IsEnabled="False" REMOVED from here so ComboBoxes / TextBoxes stay usable -->
    <Border x:Name="RootBorder" Background="White" BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1" CornerRadius="10" Padding="24,20" Height="510">
        <StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                <Border Background="#E3F0FB" BorderBrush="{StaticResource BlueBrush}" BorderThickness="1"
                        CornerRadius="20" Padding="10,3" Margin="0,0,12,0">
                    <TextBlock Text="MDR-R" FontFamily="Consolas" FontSize="9" Foreground="{StaticResource BlueBrush}"/>
                </Border>
                <TextBlock Text="RIGHT MDR"
                           FontFamily="Arial Black" FontSize="11" FontWeight="Black"
                           Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
            </StackPanel>

            <Grid Margin="0,0,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="2"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="2"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="2"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="2"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="5"/>
                </Grid.RowDefinitions>

                <!-- MOTOR TYPE -->
                <StackPanel Grid.Row="0" Grid.Column="0">
                    <TextBlock Text="▸ MOTOR TYPE" Style="{StaticResource FieldLabel}" Foreground="#5A6A8A"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="RightMotorCombo" Foreground="#5A6A8A"
                                  Grid.Column="0"
                                  Style="{StaticResource DarkComboBox}">
                            <ComboBox.ItemContainerStyle>
                                <Style TargetType="ComboBoxItem">
                                    <Setter Property="Foreground" Value="#5A6A8A"/>
                                </Style>
                            </ComboBox.ItemContainerStyle>
                        </ComboBox>
                        <Button Grid.Column="2" Content="SET" Style="{StaticResource LockableSetButton}" Click="SetRightMotorType_Click"/>
                    </Grid>
                </StackPanel>

                <!-- BRAKE METHOD -->
                <StackPanel Grid.Row="0" Grid.Column="2">
                    <TextBlock Text="▸ BRAKE METHOD" Style="{StaticResource FieldLabel}" Foreground="#5A6A8A"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="RightBrakeCombo" Foreground="#5A6A8A"
                                  Grid.Column="0"
                                  Style="{StaticResource DarkComboBox}">
                            <ComboBox.ItemContainerStyle>
                                <Style TargetType="ComboBoxItem">
                                    <Setter Property="Foreground" Value="#5A6A8A"/>
                                </Style>
                            </ComboBox.ItemContainerStyle>
                        </ComboBox>
                        <Button Grid.Column="2" Content="SET" Style="{StaticResource LockableSetButton}" Click="SetRightBrake_Click"/>
                    </Grid>
                </StackPanel>

                <!-- SPEED (range added to the label) -->
                <StackPanel Grid.Row="2" Grid.Column="0">
                    <TextBlock Text="▸ SPEED % (0-100)" Style="{StaticResource FieldLabel}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="RightSpeedTextBox" Foreground="#5A6A8A" Grid.Column="0"
                                 Style="{StaticResource DarkTextBox}" IsReadOnly="False"/>
                        <Button Grid.Column="2" Content="SET" Style="{StaticResource LockableSetButton}" Click="SetRightSpeed_Click"/>
                    </Grid>
                </StackPanel>

                <!-- CURRENT -->
                <StackPanel Grid.Row="2" Grid.Column="2">
                    <TextBlock Text="▸ CURRENT (mA)" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="RightCurrentTextBox" Foreground="#5A6A8A" Style="{StaticResource DarkTextBox}"/>
                </StackPanel>

                <!-- ACCELERATION -->
                <StackPanel Grid.Row="4" Grid.Column="0">
                    <TextBlock Text="▸ ACCELERATION ms(10-10000)" Style="{StaticResource FieldLabel}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="RightAccelTextBox" Foreground="#5A6A8A" Grid.Column="0"
                                 Style="{StaticResource DarkTextBox}" IsReadOnly="False"/>
                        <Button Grid.Column="2" Content="SET" Style="{StaticResource LockableSetButton}" Click="SetRightAccel_Click"/>
                    </Grid>
                </StackPanel>

                <!-- DECELERATION -->
                <StackPanel Grid.Row="4" Grid.Column="2">
                    <TextBlock Text="▸ DECELERATION ms(10-10000)" Style="{StaticResource FieldLabel}"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="RightDecelTextBox" Foreground="#5A6A8A" Grid.Column="0"
                                 Style="{StaticResource DarkTextBox}" IsReadOnly="False"/>
                        <Button Grid.Column="2" Content="SET" Style="{StaticResource LockableSetButton}" Click="SetDecel_Click"/>
                    </Grid>
                </StackPanel>

                <!-- DIRECTION -->
                <StackPanel Grid.Row="6" Grid.Column="0">
                    <TextBlock Text="▸ DIRECTION" Style="{StaticResource FieldLabel}" Foreground="#5A6A8A"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="RightDirectionCombo" Foreground="#5A6A8A"
                                  Grid.Column="0"
                                  Style="{StaticResource DarkComboBox}">
                            <ComboBox.ItemContainerStyle>
                                <Style TargetType="ComboBoxItem">
                                    <Setter Property="Foreground" Value="#5A6A8A"/>
                                </Style>
                            </ComboBox.ItemContainerStyle>
                            <ComboBoxItem Content="Clockwise"/>
                            <ComboBoxItem Content="Anticlockwise"/>
                        </ComboBox>
                        <Button Grid.Column="2" Content="SET" Style="{StaticResource LockableSetButton}" Click="SetRightDirection_Click"/>
                    </Grid>
                </StackPanel>
            </Grid>

            <Border Height="1" Background="WhiteSmoke" Margin="0,0,0,15"/>

            <!-- ERROR FLAGS -->
            <Border Background="WhiteSmoke" BorderBrush="#D0D5E0" BorderThickness="1"
                    CornerRadius="8" Padding="16,14" Margin="0,0,0,20" Height="130">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <Ellipse Width="7" Height="7" Fill="{StaticResource AccentBrush}"
                                 VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="ERROR FLAGS" FontWeight="Bold" FontFamily="Consolas"
                                   FontSize="10" Foreground="{StaticResource AccentBrush}"/>
                    </StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Margin="0,4">
                            <Ellipse x:Name="FlagHallSensor" Style="{StaticResource StatusIndicatorStyle}" Tag="{Binding RightHallSensorError}"/>
                            <TextBlock Text="Hall Sensor " FontFamily="Consolas" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,4">
                            <Ellipse x:Name="FlagOverCurrent" Style="{StaticResource StatusIndicatorStyle}" Tag="{Binding RightOverCurrent}"/>
                            <TextBlock Text="Over Current" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Margin="0,4">
                            <Ellipse x:Name="FlagOverVoltage" Style="{StaticResource StatusIndicatorStyle}" Tag="{Binding RightOverVoltage}"/>
                            <TextBlock Text="Over Voltage (&gt;30V)" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                        </StackPanel>

                        <!-- CHANGED: RightUnderVoltage -> RightLowVoltage (the property BL actually sets) -->
                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,4">
                            <Ellipse x:Name="FlagLowVoltage" Style="{StaticResource StatusIndicatorStyle}" Tag="{Binding RightLowVoltage}"/>
                            <TextBlock Text="Low Voltage (&lt;18V)" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                        </StackPanel>

                        <!-- CHANGED: RightMotorStalled -> RightSensor1 -->
                        <StackPanel Grid.Row="2" Grid.Column="0" Orientation="Horizontal" Margin="0,4">
                            <Ellipse x:Name="Flagrightsensor1" Style="{StaticResource StatusIndicatorStyle}" Tag="{Binding RightSensor1}"/>
                            <TextBlock Text="Right Sensor 1" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                        </StackPanel>

                        <!-- CHANGED: RightOverTemperature -> RightSensor2 -->
                        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="0,4">
                            <Ellipse x:Name="Flagrightsensor2" Style="{StaticResource StatusIndicatorStyle}" Tag="{Binding RightSensor2}"/>
                            <TextBlock Text="Right Sensor 2" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource MutedBrush}"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- RUN button (unchanged style, not affected by SetButtonsEnabled) -->
            <Button x:Name="TripleStateButton" Content="▶  RUN  " HorizontalAlignment="Stretch" Width="82" Height="30"
             Style="{StaticResource LockableSetButton}" Click="TripleStateButton_Click">

            </Button>

        </StackPanel>
    </Border>
</UserControl>

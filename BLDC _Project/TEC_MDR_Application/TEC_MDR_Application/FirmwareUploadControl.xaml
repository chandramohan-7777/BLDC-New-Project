<UserControl x:Class="YourNamespace.FirmwareUploadControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignWidth="720" d:DesignHeight="520"
             Background="#F0F0F0" Height="649"
             FontFamily="Segoe UI"
             FontSize="12">


    <Grid Margin="10,8,10,10">
        <Grid.RowDefinitions>
            <!-- Row 0: Firmware .BIN file location label -->
            <RowDefinition Height="Auto"/>
            <!-- Row 1: File path textbox + Browse button -->
            <RowDefinition Height="Auto"/>
            <!-- Row 2: Selected Devices label -->
            <RowDefinition Height="Auto"/>
            <!-- Row 3: Device list + action buttons -->
            <RowDefinition Height="Auto"/>
            <!-- Row 4: Note label -->
            <RowDefinition Height="Auto"/>
            <!-- Row 5: Output label -->
            <RowDefinition Height="Auto"/>
            <!-- Row 6: Output text area -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Row 0: Label -->
        <TextBlock Grid.Row="0"
                   Text="Firmware .BIN file location:"
                   Margin="0,0,0,3"
                   VerticalAlignment="Center"/>

        <!-- Row 1: File path + Browse -->
        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="TxtFirmwarePath"
                     Grid.Column="0"
                     Style="{StaticResource ClassicTextBoxStyle}"
                     Margin="0,0,5,0"/>

            <Button x:Name="BtnBrowse"
                    Grid.Column="1"
                    Content="Browse..."
                    Style="{StaticResource ClassicButtonStyle}"
                    MinWidth="80"
                    Click="BtnBrowse_Click"/>
        </Grid>

        <!-- Row 2: Selected Devices label -->
        <TextBlock Grid.Row="2"
                   Text="Selected Devices:"
                   Margin="0,0,0,3"
                   VerticalAlignment="Center"/>

        <!-- Row 3: Device ListBox + Upload buttons -->
        <Grid Grid.Row="3" Margin="0,0,0,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Device list -->
            <ListBox x:Name="LstDevices"
                     Grid.Column="0"
                     Style="{StaticResource ClassicListBoxStyle}"
                     Height="80"
                     SelectionMode="Extended"/>

            <!-- Buttons panel -->
            <StackPanel Grid.Column="1"
                        Margin="8,0,0,0"
                        VerticalAlignment="Top">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Upload One -->
                    <Button x:Name="BtnUploadOne"
                            Grid.Column="0"
                            Content="Upload One"
                            Style="{StaticResource ClassicButtonStyle}"
                            MinWidth="90"
                            Margin="0,0,0,0"
                            Click="BtnUploadOne_Click"/>

                    <!-- Abort Uploading (right-aligned) -->
                    <Button x:Name="BtnAbortUploading"
                            Grid.Column="2"
                            Content="Abort Uploading"
                            Style="{StaticResource ClassicButtonStyle}"
                            MinWidth="110"
                            IsEnabled="False"
                            Click="BtnAbortUploading_Click"/>
                </Grid>

                <!-- Upload ALL -->
                <Button x:Name="BtnUploadAll"
                        Content="Upload ALL"
                        Style="{StaticResource ClassicButtonStyle}"
                        MinWidth="90"
                        HorizontalAlignment="Left"
                        Margin="0,6,0,0"
                        Click="BtnUploadAll_Click"/>
            </StackPanel>
        </Grid>

        <!-- Row 4: Note -->
        <TextBlock Grid.Row="4"
                   Text="NOTE: You can select multiple devices via Network Services, &quot;Upgrade FW&quot; button."
                   Margin="0,0,0,4"
                   TextWrapping="Wrap"
                   FontSize="11"/>

        <!-- Row 5: Output label -->
        <TextBlock Grid.Row="5"
                   Text="Output:"
                   Margin="0,0,0,3"
                   VerticalAlignment="Center"/>

        <!-- Row 6: Output area -->
        <TextBox x:Name="TxtOutput"
                 Grid.Row="6"
                 Style="{StaticResource OutputTextBoxStyle}"
                 MinHeight="200"/>

    </Grid>
</UserControl>

<UserControl x:Class="BLDC_Demo.CommMotorSelectControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:BLDC_Demo"
             xmlns:models="clr-namespace:BLDC_Demo.Models"
             xmlns:controls="clr-namespace:BLDC_Demo.Controls"
             Loaded="UserControl_Loaded">
    <UserControl.Resources>
        <!-- SET button that is enabled/disabled through the SetButtonsEnabled property -->
        <Style x:Key="LockableSetButton"
    TargetType="Button"
    BasedOn="{StaticResource SetButton}">

            <Setter Property="IsEnabled"
         Value="{Binding SetButtonsEnabled,
                 RelativeSource={RelativeSource AncestorType=UserControl}}"/>

            <!-- Button Border -->
            <Setter Property="BorderBrush" Value="#999999"/>
            <Setter Property="BorderThickness" Value="1"/>

            <!-- Shadow -->
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect
             Color="#5A6A8A"
             BlurRadius="14"
             ShadowDepth="0"
             Opacity="0.30"/>
                </Setter.Value>
            </Setter>

            <Style.Triggers>

                <!-- Disabled -->
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Effect" Value="{x:Null}"/>
                    <Setter Property="Opacity" Value="0.5"/>
                    <Setter Property="BorderBrush" Value="#999999"/>
                </Trigger>

            </Style.Triggers>

        </Style>
    </UserControl.Resources>

    <Border Background="White" BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="0" CornerRadius="10" Padding="5,20"
            VerticalAlignment="Stretch">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="30"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            
            <Border Grid.Row="0" Background="White" BorderBrush="#D0D5E0" BorderThickness="1" CornerRadius="8" Padding="12,12" Margin="5,0,5,30" Grid.RowSpan="2">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <Ellipse Width="7" Height="7" Fill="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,8,0" RenderTransformOrigin="0.736,-0.544"/>
                        <TextBlock Text="Check Connection" FontWeight="Bold" FontFamily="Consolas" FontSize="9" Foreground="{StaticResource AccentBrush}" Height="11"/>
                        <TextBlock x:Name="TcpScanStatus" Text="" x:FieldModifier="public" FontFamily="Consolas" FontSize="8" Foreground="#9AA3B5" Margin="10,0,0,0" Height="11"/>

                        <!--<TextBlock Text=" — MANUAL ENTRY" FontFamily="Consolas" FontSize="9" Foreground="#9AA3B5"/>-->
                    </StackPanel>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="IP address" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource AccentBrush}"  VerticalAlignment="Center" Height="15"/>
                        <!--<StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBox x:Name="TcpIpOctet1" Width="31" MaxLength="3" TextAlignment="Center" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource AccentBrush}" Height="23" Text="192" Padding="4,4" BorderBrush="#C0C9D8" BorderThickness="1"/>
                            <TextBlock Text="." FontFamily="Consolas" FontSize="12" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="3,0"/>
                            <TextBox x:Name="TcpIpOctet2" Width="31" MaxLength="3" TextAlignment="Center" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource AccentBrush}" Height="23" Text="168" Padding="4,4" BorderBrush="#C0C9D8" BorderThickness="1"/>
                            <TextBlock Text="." FontFamily="Consolas" FontSize="12" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="3,0"/>
                            <TextBox x:Name="TcpIpOctet3" Width="31" MaxLength="3" TextAlignment="Center" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource AccentBrush}" Height="23" Text="1" Padding="4,4" BorderBrush="#C0C9D8" BorderThickness="1"/>
                            <TextBlock Text="." FontFamily="Consolas" FontSize="12" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="3,0"/>
                            <TextBox x:Name="TcpIpOctet4" Width="31" MaxLength="3" TextAlignment="Center" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource AccentBrush}" Height="23" Text="20" Padding="4,4" BorderBrush="#C0C9D8" BorderThickness="1"/>
                        </StackPanel>-->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBox x:Name="TcpIpOctet1" Style="{StaticResource RoundedIpBox}" Width="31" MaxLength="3" TextAlignment="Center" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource AccentBrush}" Height="23" Text="192" IsReadOnly="True"/>
                            <TextBlock Text="." FontFamily="Consolas" FontSize="12" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="3,0"/>
                            <TextBox x:Name="TcpIpOctet2" Style="{StaticResource RoundedIpBox}" Width="31" MaxLength="3" TextAlignment="Center" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource AccentBrush}" Height="23" Text="168" IsReadOnly="True" />
                            <TextBlock Text="." FontFamily="Consolas" FontSize="12" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="3,0"/>
                            <TextBox x:Name="TcpIpOctet3" Style="{StaticResource RoundedIpBox}" Width="31" MaxLength="3" TextAlignment="Center" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource AccentBrush}" Height="23" Text="1" />
                            <TextBlock Text="." FontFamily="Consolas" FontSize="12" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="3,0"/>
                            <TextBox x:Name="TcpIpOctet4" Style="{StaticResource RoundedIpBox}" Width="31" MaxLength="3" TextAlignment="Center" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource AccentBrush}" Height="23" Text="20" />
                        </StackPanel>
                    </Grid>
                    <!--<Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="IP address " FontFamily="Consolas" FontSize="10" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                        <TextBox x:Name="TcpIpAddress" Grid.Column="1" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource AccentBrush}" Height="28" Text="192.168.1.20" Padding="6,4" BorderBrush="#C0C9D8" BorderThickness="1"/>
                    </Grid>-->

                    <!--<Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="TCP port " FontFamily="Consolas" FontSize="10" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                        <TextBox x:Name="TcpPort" Grid.Column="1" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource AccentBrush}" Height="28" Text="502" Padding="6,4" BorderBrush="#C0C9D8" BorderThickness="1"/>
                    </Grid>-->

                    <Button x:Name="TcpConnectButton"  Grid.Column="1"  Style="{StaticResource SetButton}" Click="TcpConnectButton_Click" Content="Connect"  Height="30" Width="70" HorizontalAlignment="Left" >
                        <Button.Effect>
                            <DropShadowEffect Color="#1565C0" BlurRadius="14" ShadowDepth="0" Opacity="0.35"/>
                        </Button.Effect>
                    </Button>
                </StackPanel>
            </Border>
            <Border Grid.Row="2" Background="White" BorderBrush="#D0D5E0" BorderThickness="1" CornerRadius="8" Padding="12,12" Margin="5,0,5,30">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <Ellipse Width="7" Height="7" Fill="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Blink&amp;Wink" FontWeight="Bold" FontFamily="Consolas" FontSize="9" Foreground="{StaticResource AccentBrush}"/>
                    </StackPanel>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="IP address" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource AccentBrush}"  VerticalAlignment="Center" Height="15"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBox x:Name="TcpIpOctet1_BW" Width="31" MaxLength="3" Style="{StaticResource RoundedIpBox}" TextAlignment="Center" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource AccentBrush}" Height="23" Text="192" BorderBrush="#C0C9D8" BorderThickness="1" IsReadOnly="True"/>
                            <TextBlock Text="." FontFamily="Consolas" FontSize="12" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="3,0"/>
                            <TextBox x:Name="TcpIpOctet2_BW" Width="31" MaxLength="3" Style="{StaticResource RoundedIpBox}" TextAlignment="Center" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource AccentBrush}" Height="23" Text="168" BorderBrush="#C0C9D8" BorderThickness="1" IsReadOnly="True"/>
                            <TextBlock Text="." FontFamily="Consolas" FontSize="12" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="3,0"/>
                            <TextBox x:Name="TcpIpOctet3_BW" Width="31" MaxLength="3" Style="{StaticResource RoundedIpBox}" TextAlignment="Center" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource AccentBrush}" Height="23" Text="1"  BorderBrush="#C0C9D8" BorderThickness="1"/>
                            <TextBlock Text="." FontFamily="Consolas" FontSize="12" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="3,0"/>
                            <TextBox x:Name="TcpIpOctet4_BW" Width="31" MaxLength="3" Style="{StaticResource RoundedIpBox}" TextAlignment="Center" FontFamily="Consolas" FontSize="11" Foreground="{StaticResource AccentBrush}" Height="23" Text="20"  BorderBrush="#C0C9D8" BorderThickness="1"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <Button x:Name="TripleStateButton" IsEnabled = "false" Style="{StaticResource LockableSetButton}" Click="TripleStateButton_Click" Content="ON" Height="30" Width="70" HorizontalAlignment="Left" Margin="0,0,10,0">
                      
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Row 3: Advanced Configuration -->
            <Border Grid.Row="3" Background="White" BorderBrush="#D0D5E0" BorderThickness="1" CornerRadius="8" Padding="12,12" Margin="5,0,5,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Ellipse Width="7" Height="7" Fill="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="Advanced Configuration" FontWeight="Bold" FontFamily="Consolas" FontSize="9" Foreground="{StaticResource AccentBrush}"/>
                    </StackPanel>

                    <Button Content="ADVANCED" Click="AdvancedButton_Click" Style="{StaticResource AdvancedButton}" HorizontalAlignment="Left">
                        <Button.Effect>
                            <DropShadowEffect Color="#5A6A8A" BlurRadius="8" ShadowDepth="0" Opacity="0.20"/>
                        </Button.Effect>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>


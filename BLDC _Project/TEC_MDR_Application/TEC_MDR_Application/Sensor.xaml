<UserControl x:Class="BLDC_Demo.Sensor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:BLDC_Demo"
             mc:Ignorable="d" 
             Height="552"
             Width="760"
         
        >
    <UserControl.Resources>
        <Style TargetType="RadioButton">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,24,0"/>
            <Setter Property="Foreground" Value="{StaticResource LabelBrush}"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="10"/>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="9"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#6B7280"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style x:Key="SensorCard" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="32,24"/>
            <Setter Property="Width" Value="336"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </UserControl.Resources>

    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
        <Grid.RowDefinitions>
            <RowDefinition Height="240"/>
            <RowDefinition Height="20"/>
            <RowDefinition Height="240"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320"/>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="320"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT SENSOR 1 -->
        <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource SensorCard}" HorizontalAlignment="Center" CornerRadius="10" Width="290">
            <StackPanel Margin="0,0,0,0">
                <TextBlock Text="Left Sensor 1 Configuration" Foreground="{StaticResource AccentBrush}"
                           FontFamily="Arial Black" FontSize="12" FontWeight="Black" Margin="0,0,0,24"/>
                <StackPanel Margin="0,0,0,0">
                    <TextBlock Text="SENSOR TYPE" Style="{StaticResource FieldLabel}"/>
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="LeftSensor1NpnRadioButton" Content="NPN" GroupName="LeftSensor1TypeGroup" IsChecked="True" Width="80"/>
                        <RadioButton x:Name="LeftSensor1PnpRadioButton" Content="PNP" GroupName="LeftSensor1TypeGroup" Width="38"/>
                    </StackPanel>
                </StackPanel>
                <Border BorderBrush="#F3F4F6" BorderThickness="0,1,0,0" Margin="0,4,0,16"/>
                <StackPanel Margin="0,0,0,28">
                    <TextBlock Text="CONTACT STATE" Style="{StaticResource FieldLabel}"/>
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="LeftSensor1NoRadioButton" Content="NO " GroupName="LeftSensor1ContactGroup" IsChecked="True" Width="80"/>
                        <RadioButton x:Name="LeftSensor1NcRadioButton" Content="NC " GroupName="LeftSensor1ContactGroup" Width="38"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Margin="0,0,20,0" Width="100">
                    <Button Content="Save" Style="{StaticResource SetButton}" Height="30" Width="91" Click="SaveLeftSensor1Button_Click">
                        <Button.Effect>
                            <DropShadowEffect Color="#2563EB" BlurRadius="10" ShadowDepth="1" Opacity="0.2"/>
                        </Button.Effect>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- RIGHT SENSOR 1 -->
        <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource SensorCard}" HorizontalAlignment="Center"  CornerRadius="10" Width="290">
            <StackPanel>
                <TextBlock Text="Right Sensor 1 Configuration" Foreground="{StaticResource AccentBrush}"
                           FontFamily="Arial Black" FontSize="12" FontWeight="Black" Margin="0,0,0,24"/>
                <StackPanel Margin="0,0,0,0">
                    <TextBlock Text="SENSOR TYPE" Style="{StaticResource FieldLabel}"/>
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="RightSensor1NpnRadioButton" Content="NPN" GroupName="RightSensor1TypeGroup" IsChecked="True" Width="80"/>
                        <RadioButton x:Name="RightSensor1PnpRadioButton" Content="PNP" GroupName="RightSensor1TypeGroup" Width="38"/>
                    </StackPanel>
                </StackPanel>
                <Border BorderBrush="#F3F4F6" BorderThickness="0,1,0,0" Margin="0,4,0,16"/>
                <StackPanel Margin="0,0,0,28">
                    <TextBlock Text="CONTACT STATE" Style="{StaticResource FieldLabel}"/>
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="RightSensor1NoRadioButton" Content="NO " GroupName="RightSensor1ContactGroup" IsChecked="True" Width="80"/>
                        <RadioButton x:Name="RightSensor1NcRadioButton" Content="NC " GroupName="RightSensor1ContactGroup" Width="38"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Margin="0,0,20,0" Width="100">
                    <Button Content="Save" Style="{StaticResource SetButton}" Height="30" Width="91" Click="SaveRightSensor1Button_Click">
                        <Button.Effect>
                            <DropShadowEffect Color="#1565C0" BlurRadius="14" ShadowDepth="0" Opacity="0.35"/>
                        </Button.Effect>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- LEFT SENSOR 2 -->
        <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource SensorCard}" HorizontalAlignment="Center"  CornerRadius="10" Width="290">
            <StackPanel>
                <TextBlock Text="Left Sensor 2 Configuration" Foreground="{StaticResource AccentBrush}"
                           FontFamily="Arial Black" FontSize="12" FontWeight="Black" Margin="0,0,0,24"/>
                <StackPanel Margin="0,0,0,0">
                    <TextBlock Text="SENSOR TYPE" Style="{StaticResource FieldLabel}"/>
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="LeftSensor2NpnRadioButton" Content="NPN" GroupName="LeftSensor2TypeGroup" IsChecked="True" Width="80"/>
                        <RadioButton x:Name="LeftSensor2PnpRadioButton" Content="PNP" GroupName="LeftSensor2TypeGroup" Width="38"/>
                    </StackPanel>
                </StackPanel>
                <Border BorderBrush="#F3F4F6" BorderThickness="0,1,0,0" Margin="0,4,0,16"/>
                <StackPanel Margin="0,0,0,28">
                    <TextBlock Text="CONTACT STATE" Style="{StaticResource FieldLabel}"/>
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="LeftSensor2NoRadioButton" Content="NO " GroupName="LeftSensor2ContactGroup" IsChecked="True" Width="80"/>
                        <RadioButton x:Name="LeftSensor2NcRadioButton" Content="NC " GroupName="LeftSensor2ContactGroup" Width="38"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Margin="0,0,20,0" Width="100">
                    <Button Content="Save" Style="{StaticResource SetButton}" Height="30" Width="91" Click="SaveLeftSensor2Button_Click">
                        <Button.Effect>
                            <DropShadowEffect Color="#2563EB" BlurRadius="10" ShadowDepth="1" Opacity="0.2"/>
                        </Button.Effect>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- RIGHT SENSOR 2 -->
        <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource SensorCard}"  HorizontalAlignment="Center"  CornerRadius="10" Width="290">
            <StackPanel>
                <TextBlock Text="Right Sensor 2 Configuration" Foreground="{StaticResource AccentBrush}"
                           FontFamily="Arial Black" FontSize="12" FontWeight="Black" Margin="0,0,0,24"/>
                <StackPanel Margin="0,0,0,0">
                    <TextBlock Text="SENSOR TYPE" Style="{StaticResource FieldLabel}"/>
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="RightSensor2NpnRadioButton" Content="NPN" GroupName="RightSensor2TypeGroup" IsChecked="True" Width="80"/>
                        <RadioButton x:Name="RightSensor2PnpRadioButton" Content="PNP" GroupName="RightSensor2TypeGroup" Width="38"/>
                    </StackPanel>
                </StackPanel>
                <Border BorderBrush="#F3F4F6" BorderThickness="0,1,0,0" Margin="0,4,0,16"/>
                <StackPanel Margin="0,0,0,28">
                    <TextBlock Text="CONTACT STATE" Style="{StaticResource FieldLabel}"/>
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="RightSensor2NoRadioButton" Content="NO " GroupName="RightSensor2ContactGroup" IsChecked="True" Width="80"/>
                        <RadioButton x:Name="RightSensor2NcRadioButton" Content="NC " GroupName="RightSensor2ContactGroup" Width="38"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Margin="0,0,20,0" Width="100">
                    <Button Content="Save" Style="{StaticResource SetButton}" Height="30" Width="91" Click="SaveRightSensor2Button_Click">
                        <Button.Effect>
                            <DropShadowEffect Color="#1565C0" BlurRadius="14" ShadowDepth="0" Opacity="0.35"/>
                        </Button.Effect>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
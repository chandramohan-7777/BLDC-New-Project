<UserControl x:Class="BLDC_Demo.Motor_Type"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:BLDC_Demo"
             mc:Ignorable="d" 
             Height="552"
             Width="760"
          
             FontFamily="Segoe UI"
        
             Loaded="UserControl_Loaded">
    <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="24"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ══════════════════════════════════════════════════════
             LEFT SIDE — ADD MOTOR TYPE
             ══════════════════════════════════════════════════════ -->
        <Border Grid.Column="0" Background="White" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1" CornerRadius="10" Padding="20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" MinHeight="30"/>
                    <RowDefinition Height="55"/>
                    <RowDefinition Height="55"/>
                    <RowDefinition Height="70"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.ColumnSpan="2"
                           Text="ADD MOTOR TYPE"
                           FontFamily="Arial Black" FontSize="11" FontWeight="Black"
                           Foreground="{StaticResource AccentBrush}"
                           Margin="0,0,0,10"/>

                <!-- NAME : same style as the SPEED box (DarkTextBox + #5A6A8A) -->
                <TextBlock Grid.Row="1" Grid.Column="0" 
                           Text="NAME" 
                           Style="{StaticResource FieldLabel}" 
                           VerticalAlignment="Center"/>
                <TextBox Grid.Row="1" Grid.Column="1"
         x:Name="NameTextBox"
         Width="180"
         HorizontalAlignment="Left"
         VerticalAlignment="Center"
         FontFamily="Consolas"
         FontSize="12"
         FontWeight="Normal"
         Foreground="#5A6A8A"
         Style="{StaticResource DarkTextBox}"
         IsReadOnly="False"/>

                <!-- GEAR : same style as the SPEED box (DarkTextBox + #5A6A8A) -->
                <TextBlock Grid.Row="2" Grid.Column="0" 
                           Text="GEAR" 
                           Style="{StaticResource FieldLabel}" 
                           VerticalAlignment="Center"/>
                <TextBox Grid.Row="2" Grid.Column="1"
         x:Name="GearTextBox1"
         Width="180"
         HorizontalAlignment="Left"
         VerticalAlignment="Center"
         FontFamily="Consolas"
         FontSize="12"
         FontWeight="Normal"
         Foreground="#5A6A8A"
         Style="{StaticResource DarkTextBox}"
         IsReadOnly="False"/>

                <StackPanel Grid.Row="3" Grid.Column="1" VerticalAlignment="Center" >
                    <Button x:Name ="AddButton" Content="Add" 
                            Style="{StaticResource SetButton}" 
                            Width="80" 
                            Click="AddButton_Click">
                        <Button.Effect>
                            <DropShadowEffect Color="#5A6A8A" BlurRadius="14" ShadowDepth="0" Opacity="0.35"/>
                        </Button.Effect>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══════════════════════════════════════════════════════
             RIGHT SIDE — REMOVE MOTOR TYPE
             ══════════════════════════════════════════════════════ -->
        <Border Grid.Column="2" Background="White" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1" CornerRadius="10" Padding="20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" MinHeight="30"/>
                    <RowDefinition Height="55"/>
                    <RowDefinition Height="70"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.ColumnSpan="2"
                           Text="REMOVE MOTOR TYPE"
                           FontFamily="Arial Black" FontSize="11" FontWeight="Black"
                           Foreground="{StaticResource AccentBrush}"
                           Margin="0,0,0,10"/>

                <TextBlock Grid.Row="1" Grid.Column="0" 
                           Text="NAME" 
                           Style="{StaticResource FieldLabel}" 
                           VerticalAlignment="Center"/>
                <ComboBox Grid.Row="1" Grid.Column="1"
          x:Name="RemoveMotorCombo"
          Width="180"
          HorizontalAlignment="Left"
          VerticalAlignment="Center"
          FontFamily="Consolas"
          FontSize="12"
          FontWeight="Normal"
          Foreground="#5A6A8A"
          Style="{StaticResource DarkComboBox}">
                    <ComboBox.ItemContainerStyle>
                        <Style TargetType="ComboBoxItem">
                            <Setter Property="FontFamily" Value="Consolas"/>
                            <Setter Property="FontSize" Value="12"/>
                            <Setter Property="Foreground" Value="#5A6A8A"/>
                        </Style>
                    </ComboBox.ItemContainerStyle>
                </ComboBox>

                <StackPanel Grid.Row="2" Grid.Column="1" VerticalAlignment="Center" >

                    <Button Content="Remove" 
                            Style="{StaticResource SetButton}" 
                            Width="80"    x:Name="RemoveButton"
                            Click="RemoveButton_Click">
                        <Button.Effect>
                            <DropShadowEffect Color="#5A6A8A" BlurRadius="14" ShadowDepth="0" Opacity="0.35"/>
                        </Button.Effect>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
